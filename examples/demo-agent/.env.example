# Sales channel access key: Admin -> Sales channels -> <channel> -> API access
SW_ACCESS_KEY=

# Payer private key (0x-prefixed). Use a throwaway test key.
# For Base Sepolia, fund it with test USDC at https://faucet.circle.com
PAYER_PK=

# Shop base URL
BASE_URL=http://localhost:8000

# Optional: buy a specific product instead of the first available one
#PRODUCT_ID=

# Optional: billing country ISO (default DE)
#COUNTRY_ISO=DE

# Optional: refuse payments above this many atomic units.
# Default: exactly the order total, so the agent never overpays.
#MAX_ATOMIC=10000000

# Optional: set to 1 to prove order ownership ONLY via deepLinkCode
# (simulates a UCP-placed order where the agent has no context token)
#DEEP_LINK_ONLY=0
